{
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "compilerOptions": {
    "lib": [
      "es2017",
      "dom"
    ],
    "types": [
      "react",
      "react-native"
    ],
    "skipLibCheck": true
  }
}